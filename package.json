{
  "name": "listny",
  "version": "0.2.0",
  "description": "Open-source voice dictation for macOS: press a hotkey, speak, and the text is pasted where your cursor is. Bring your own speech-to-text key.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/settings.cjs && node --check electron/transcribe.cjs && node --check electron/paste.cjs && node --check electron/audio.cjs && node --test test/ && vite build",
    "dist": "vite build && electron-builder --mac",
    "dist:release": "vite build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "license": "MIT",
  "homepage": "https://github.com/kaiser-data/listny#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiser-data/listny.git"
  },
  "bugs": {
    "url": "https://github.com/kaiser-data/listny/issues"
  },
  "keywords": [
    "dictation",
    "voice",
    "speech-to-text",
    "whisper",
    "macos",
    "electron",
    "menu-bar",
    "open-source"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "author": "kaiser-data",
  "build": {
    "appId": "com.kaiserdata.listny",
    "productName": "Listny",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Listny records your voice while you dictate so it can turn it into text.",
        "NSAppleEventsUsageDescription": "Listny pastes your dictation into the active app and mutes audio while you speak."
      }
    },
    "afterPack": "build/sign.cjs",
    "artifactName": "Listny-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 kaiser-data"
  },
  "private": true
}
